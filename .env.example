# Environment variables for the application where values go into .env and .env is never committed
# SA password rule: at least 8 characters, with an uppercase letter, a lowercase letter, a number and a symbol. Avoid $, # and quotes: Docker Compose reads them as special characters.
MSSQL_SA_PASSWORD=
# Value is generated, not invented. PP_DB_PASSWORD is used to create the pp_app login and user in the patientping database. It is also used by the application to connect to the database.
PP_DB_PASSWORD=
# Only letters, digits and - _ . in the passwords: the sa password also goes into a URL in compose.yaml.
