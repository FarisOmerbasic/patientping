{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListThePatientpingPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::pp-sandbox-111122223333",
      "Condition": {
        "StringLike": {
          "s3:prefix": "patientping/*"
        }
      }
    },
    {
      "Sid": "ReadWritePatientpingFiles",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::pp-sandbox-111122223333/patientping/*"
    },
    {
      "Sid": "LogInToEcr",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "PullPatientpingApiImage",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer"
      ],
      "Resource": "arn:aws:ecr:us-east-1:111122223333:repository/patientping-api"
    }
  ]
}
