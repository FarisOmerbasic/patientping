{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadResultsAndFindTheServer",
      "Effect": "Allow",
      "Action": [
        "ssm:GetCommandInvocation",
        "ec2:DescribeInstances"
      ],
      "Resource": "*"
    },
    {
      "Sid": "RunShellScriptOnly",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": "arn:aws:ssm:us-east-1::document/AWS-RunShellScript"
    },
    {
      "Sid": "OnlyTheDevServer",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": "arn:aws:ec2:us-east-1:586631277130:instance/*",
      "Condition": {
        "StringEquals": {
          "ssm:resourceTag/Name": "patientping-dev"
        }
      }
    }
  ]
}
